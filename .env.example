# Copie este arquivo para .env.local e preencha os valores.
# Depois de alterar, reinicie o `npm run dev` ou gere um novo build.

# PENDENTE: número do WhatsApp da Green Ocean, somente dígitos,
# com DDI 55 + DDD + número. Ex.: 55519XXXXXXXX (não use este exemplo).
WHATSAPP_NUMBER=

# Opcional: @ do Instagram da Green Ocean (com ou sem "@").
# Se ficar vazio, o convite para seguir no Instagram não aparece no rodapé.
INSTAGRAM_HANDLE=
